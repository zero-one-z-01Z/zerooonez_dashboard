<?php

use {{ controller_namespace }}\{{ model }}Controller;
use Illuminate\Support\Facades\Route;

// Loaded by the package route group; all_routes applies generated capability gates.
Route::prefix({{ resource }})->name({{ route_name }})->controller({{ model }}Controller::class)
    ->middleware({{ view_permission }})->group(function () {
        all_routes({{ permission }});
    });
